{% if section.settings.eyebrow != blank %}
  {% assign faq_eyebrow = section.settings.eyebrow %}
{% else %}
  {% assign faq_eyebrow = 'landing.faq_eyebrow' | t %}
{% endif %}
{% if section.settings.heading != blank %}
  {% assign faq_heading = section.settings.heading %}
{% else %}
  {% assign faq_heading = 'landing.faq_heading' | t %}
{% endif %}

<section class="section" id="{{ section.settings.anchor | default: 'faq' }}">
  <div class="page-width">
    <div class="section-heading {% if section.settings.center %}text-center{% endif %}">
      {% if faq_eyebrow != blank %}
        <p class="eyebrow">{{ faq_eyebrow }}</p>
      {% endif %}
      {% if faq_heading != blank %}
        <h2>{{ faq_heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="lede">{{ section.settings.text }}</p>
      {% endif %}
    </div>

    <div class="faq" {% if section.settings.center %}style="margin-inline:auto"{% endif %}>
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <details {{ block.shopify_attributes }} {% if forloop.first and section.settings.open_first %}open{% endif %}>
            <summary>{{ block.settings.question }}</summary>
            <div class="rte">{{ block.settings.answer }}</div>
          </details>
        {% endfor %}
      {% else %}
        <details {% if section.settings.open_first %}open{% endif %}>
          <summary>{{ 'landing.faq_1_q' | t }}</summary>
          <div class="rte"><p>{{ 'landing.faq_1_a' | t }}</p></div>
        </details>
        <details>
          <summary>{{ 'landing.faq_2_q' | t }}</summary>
          <div class="rte"><p>{{ 'landing.faq_2_a' | t }}</p></div>
        </details>
        <details>
          <summary>{{ 'landing.faq_3_q' | t }}</summary>
          <div class="rte"><p>{{ 'landing.faq_3_a' | t }}</p></div>
        </details>
        <details>
          <summary>{{ 'landing.faq_4_q' | t }}</summary>
          <div class="rte"><p>{{ 'landing.faq_4_a' | t }}</p></div>
        </details>
        <details>
          <summary>{{ 'landing.faq_5_q' | t }}</summary>
          <div class="rte"><p>{{ 'landing.faq_5_a' | t }}</p></div>
        </details>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "ID ancora",
      "default": "faq"
    },
    {
      "type": "checkbox",
      "id": "center",
      "label": "Centra intestazione",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Apri la prima domanda",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Senza blocchi: usa le traduzioni IT/EN."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (override)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo (override)"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Sottotitolo (override)"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Domanda",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Domanda"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Risposta"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}
