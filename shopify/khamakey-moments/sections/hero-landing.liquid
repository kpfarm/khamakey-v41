{% if section.settings.eyebrow != blank %}
  {% assign hero_eyebrow = section.settings.eyebrow %}
{% else %}
  {% assign hero_eyebrow = 'landing.hero_eyebrow' | t %}
{% endif %}
{% if section.settings.heading != blank %}
  {% assign hero_heading = section.settings.heading %}
{% else %}
  {% assign hero_heading = 'landing.hero_heading' | t %}
{% endif %}
{% if section.settings.text != blank %}
  {% assign hero_text = section.settings.text %}
{% else %}
  {% assign hero_text = 'landing.hero_text' | t %}
{% endif %}
{% if section.settings.button_label != blank %}
  {% assign hero_cta = section.settings.button_label %}
{% else %}
  {% assign hero_cta = 'landing.hero_cta' | t %}
{% endif %}
{% if section.settings.button_secondary_label != blank %}
  {% assign hero_cta2 = section.settings.button_secondary_label %}
{% else %}
  {% assign hero_cta2 = 'landing.hero_cta_secondary' | t %}
{% endif %}

<section class="hero" aria-label="{{ hero_heading | escape }}">
  <div class="hero__media">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '800, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.image.alt | default: hero_heading
      }}
    {% else %}
      <img
        src="{{ 'hero-moments.jpg' | asset_url }}"
        alt="{{ hero_heading | escape }}"
        width="1600"
        height="1000"
        loading="eager"
        fetchpriority="high"
      >
    {% endif %}
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="page-width">
    <div class="hero__content">
      {% if hero_eyebrow != blank %}
        <p class="eyebrow">{{ hero_eyebrow }}</p>
      {% endif %}
      {% if hero_heading != blank %}
        <h1>{{ hero_heading }}</h1>
      {% endif %}
      {% if hero_text != blank %}
        <p class="lede">{{ hero_text }}</p>
      {% endif %}
      <div class="btn-group">
        {% if hero_cta != blank %}
          <a class="btn btn--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ hero_cta }}
          </a>
        {% endif %}
        {% if hero_cta2 != blank %}
          <a class="btn btn--ghost" href="{{ section.settings.button_secondary_link | default: '#come-funziona' }}" style="color:#fff;border-color:rgba(255,255,255,.45)">
            {{ hero_cta2 }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero landing",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Immagine hero (full-bleed)"
    },
    {
      "type": "paragraph",
      "content": "Lascia i testi vuoti per usare le traduzioni IT/EN del tema (locales)."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (override)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo (override)"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Sottotitolo (override)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "CTA primaria (override)"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link CTA primaria"
    },
    {
      "type": "text",
      "id": "button_secondary_label",
      "label": "CTA secondaria (override)"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "label": "Link CTA secondaria"
    }
  ],
  "presets": [
    {
      "name": "Hero landing"
    }
  ]
}
{% endschema %}
