<section class="page-width cart">
  <h1>{{ 'cart.title' | t }}</h1>

  {% if cart.item_count == 0 %}
    <div class="cart-empty">
      <h2>{{ 'cart.empty' | t }}</h2>
      <p>{{ settings.cart_empty_message }}</p>
      <div class="btn-group" style="justify-content:center">
        <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
      </div>
    </div>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post" id="cart">
      <table class="cart-table">
        <thead>
          <tr>
            <th>{{ 'cart.product' | t }}</th>
            <th>{{ 'cart.quantity' | t }}</th>
            <th>{{ 'cart.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {% for item in cart.items %}
            <tr>
              <td>
                <div class="cart-item">
                  {% if item.image %}
                    {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.image.alt | default: item.product.title }}
                  {% endif %}
                  <div>
                    <p class="cart-item__title">
                      <a href="{{ item.url }}">{{ item.product.title }}</a>
                    </p>
                    {% unless item.product.has_only_default_variant %}
                      <p>{{ item.variant.title }}</p>
                    {% endunless %}
                    <p>{{ item.final_price | money }}</p>
                    <a href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
                  </div>
                </div>
              </td>
              <td>
                <input
                  class="cart-qty"
                  type="number"
                  name="updates[{{ item.key }}]"
                  value="{{ item.quantity }}"
                  min="0"
                  aria-label="{{ 'cart.quantity' | t }}"
                >
              </td>
              <td>{{ item.final_line_price | money }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      {% if settings.cart_note_enable %}
        <div class="product-form__row" style="max-width:420px;margin-top:1.5rem">
          <label for="CartNote">{{ 'cart.note' | t }}</label>
          <textarea id="CartNote" name="note" rows="3" style="width:100%;border-radius:12px;border:1px solid color-mix(in srgb, var(--color-secondary) 18%, transparent);padding:0.75rem;background:#fff">{{ cart.note }}</textarea>
        </div>
      {% endif %}

      <div class="cart-summary">
        <div class="cart-summary__row">
          <span>{{ 'cart.subtotal' | t }}</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>
        <p style="font-size:0.9rem;color:color-mix(in srgb, var(--color-text) 70%, transparent)">
          {{ 'cart.taxes_shipping' | t }}
        </p>
        <div class="btn-group" style="flex-direction:column">
          <button type="submit" name="update" class="btn btn--ghost btn--full">{{ 'cart.update' | t }}</button>
          <button type="submit" name="checkout" class="btn btn--primary btn--full">{{ 'cart.checkout' | t }}</button>
        </div>
      </div>
    </form>
  {% endif %}
</section>

{% schema %}
{
  "name": "Carrello",
  "settings": []
}
{% endschema %}
