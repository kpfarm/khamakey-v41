{% comment %}
  Language switcher (IT / EN / DE). Visible only when more than one language is enabled in Shopify Admin.
  Pass form_id when rendering twice on the same page (header + mobile) to avoid duplicate IDs.
{% endcomment %}
{% if localization.available_languages.size > 1 %}
  {% assign lang_form_id = form_id | default: 'LocalizationForm' %}
  <div class="lang-switch" role="group" aria-label="{{ 'general.language' | t }}">
    {% form 'localization', id: lang_form_id %}
      {% for language in localization.available_languages %}
        <button
          type="submit"
          name="locale_code"
          value="{{ language.iso_code }}"
          class="lang-switch__select{% if language.iso_code == localization.language.iso_code %} is-active{% endif %}"
          aria-pressed="{% if language.iso_code == localization.language.iso_code %}true{% else %}false{% endif %}"
          {% if language.iso_code == localization.language.iso_code %}aria-current="true"{% endif %}
        >
          {{ language.iso_code | upcase }}
        </button>
      {% endfor %}
      <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">
    {% endform %}
  </div>
{% endif %}
