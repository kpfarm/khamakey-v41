{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ gift_card.balance | money }} — {{ shop.name }}</title>
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body>
    <main class="page-width section text-center">
      <p class="eyebrow">{{ shop.name }}</p>
      <h1>{{ 'general.home' | t }} Gift Card</h1>
      <p class="lede">{{ gift_card.balance | money }}</p>
      {% if gift_card.enabled %}
        <p><strong>{{ gift_card.code }}</strong></p>
        <a class="btn btn--primary" href="{{ gift_card.url }}">Apri gift card</a>
      {% endif %}
    </main>
  </body>
</html>
